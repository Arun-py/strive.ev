{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "▶ Auto Commit + Deploy (Vercel + Render)",
      "type": "shell",
      "command": "powershell.exe",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy", "Bypass",
        "-File", "${workspaceFolder}\\.vscode\\watch-and-deploy.ps1"
      ],
      "isBackground": true,
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true,
        "echo": false
      },
      "problemMatcher": []
    }
  ]
}
